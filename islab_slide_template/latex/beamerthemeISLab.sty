% =====================================================================
%  CÁC TRANG ĐẶC BIỆT
% =====================================================================
% \ISLabTrangBia — lấy \title, \subtitle, \author, \institute, \date
\newcommand{\ISLabTrangBia}{{%
  \setbeamertemplate{background canvas}{\ISLabNenBia}%
  \frame[plain,noframenumbering]{%
    \begin{tikzpicture}[remember picture,overlay,x=1cm,y=1cm,shift={(current page.south west)}]
      \node[anchor=south west,inner sep=0,text width=8.5cm,align=flush left,text=white,
            font=\bfseries\fontsize{17}{21}\selectfont] at (0.66,4.2) {\inserttitle};
      \fill[islabcam] (0.66,3.84) rectangle (2.26,3.92);
      \node[anchor=north west,inner sep=0,text width=8.5cm,align=flush left,text=islabphu,
            font=\fontsize{9}{12}\selectfont] at (0.66,3.55) {\insertsubtitle};
      \node[anchor=south west,inner sep=0,text width=8.5cm,align=flush left,text=white,
            font=\fontsize{7.5}{11}\selectfont] at (0.66,0.75)
        {{\bfseries\fontsize{8.5}{11}\selectfont\insertauthor}\\[1pt]
         {\color{islabphu}\insertinstitute}\\[1pt]{\color{islabphu}\insertdate}};
    \end{tikzpicture}}}}

% \ISLabTrangMuc{01}{Tên phần}{Mô tả ngắn}
\newcommand{\ISLabTrangMuc}[3]{{%
  \setbeamertemplate{background canvas}{\ISLabNenMuc}%
  \frame[plain,noframenumbering]{%
    \begin{tikzpicture}[remember picture,overlay,x=1cm,y=1cm,shift={(current page.south west)}]
      \node[anchor=center,inner sep=0,text=white,font=\bfseries\fontsize{46}{46}\selectfont]
        at (2.6,5.0) {#1};
      \node[anchor=south west,inner sep=0,text width=8.9cm,align=flush left,text=islabis,
            font=\bfseries\fontsize{17}{21}\selectfont] at (6.1,4.65) {#2};
      \node[anchor=north west,inner sep=0,text width=8.9cm,align=flush left,text=islabmo,
            font=\fontsize{9}{12.5}\selectfont] at (6.1,4.3) {#3};
    \end{tikzpicture}}}}

% \ISLabTrangKet{Lời kết}{Dòng phụ}{Thông tin liên hệ}
\newcommand{\ISLabTrangKet}[3]{{%
  \setbeamertemplate{background canvas}{\ISLabNenBia}%
  \frame[plain,noframenumbering]{%
    \begin{tikzpicture}[remember picture,overlay,x=1cm,y=1cm,shift={(current page.south west)}]
      \node[anchor=south west,inner sep=0,text width=8.5cm,align=flush left,text=white,
            font=\bfseries\fontsize{17}{21}\selectfont] at (0.66,4.2) {#1};
      \fill[islabcam] (0.66,3.84) rectangle (2.26,3.92);
      \node[anchor=north west,inner sep=0,text width=8.5cm,align=flush left,text=islabphu,
            font=\fontsize{9}{12}\selectfont] at (0.66,3.55) {#2};
      \node[anchor=south west,inner sep=0,text width=8.5cm,align=flush left,text=islabphu,
            font=\fontsize{7.5}{11}\selectfont] at (0.66,0.75) {#3};
    \end{tikzpicture}}}}

% =====================================================================
%  CÁC KHỐI DÙNG LẠI TRONG TRANG NỘI DUNG
% =====================================================================
% \ISLabSo{36,2\%}{nhãn} — ô số liệu, đặt trong \column hoặc minipage
\newcommand{\ISLabSo}[2]{%
  \begin{tikzpicture}
    \node[rounded corners=2.5pt,fill=islabnhat,draw=islabvien,line width=0.4pt,
          minimum height=1.3cm,text width=\dimexpr\linewidth-10pt\relax,align=center,inner sep=4pt]
      {{\bfseries\color{islabcam}\fontsize{13}{15}\selectfont #1}\\[2pt]
       {\fontsize{6.5}{8}\selectfont\color{islabmo}#2}};
  \end{tikzpicture}}

% \ISLabThe[chiều cao tối thiểu]{01}{Tiêu đề}{Nội dung} — thẻ có số thứ tự
\newcommand{\ISLabThe}[4][0.9cm]{%
  \begin{tikzpicture}
    \node[fill=islabnhat,minimum height=#1,text width=\dimexpr\linewidth-18pt\relax,
          align=flush left,inner xsep=7pt,inner ysep=4.5pt] (the)
      {{\bfseries\color{islabcam}\fontsize{9}{11}\selectfont #2}\hspace{0.6em}%
       {\bfseries\color{islabis}\fontsize{8.5}{11}\selectfont #3}\\[1.5pt]
       {\fontsize{7.5}{10}\selectfont\color{islabchu}#4}};
    \fill[islabis] (the.north west) rectangle ([xshift=2pt]the.south west);
  \end{tikzpicture}}

% \ISLabNhan{chữ} — nhãn nhỏ màu nhấn, ví dụ đánh dấu "Kết quả chính"
\newcommand{\ISLabNhan}[1]{%
  \tikz[baseline=(n.base)]\node[fill=islabcam,text=white,rounded corners=2pt,inner xsep=4pt,
    inner ysep=2pt,font=\bfseries\fontsize{6.5}{8}\selectfont] (n) {#1};}

