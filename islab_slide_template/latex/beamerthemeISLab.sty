% =====================================================================
%  beamerthemeISLab.sty — khung slide chung của ISLab
%  (Intelligent Systems Laboratory)
%
%  Dùng:   \documentclass[aspectratio=169,10pt]{beamer}
%          \usetheme{ISLab}
%  Biên dịch HAI lần bằng pdflatex (trang bìa và trang chuyển mục đặt chữ
%  theo toạ độ tuyệt đối của trang nên cần lần chạy thứ hai).
%
%  Logo và ảnh nền nằm ở ../assets. Nếu để chỗ khác, khai báo TRƯỚC \usetheme:
%          \newcommand{\ISLabAssets}{duong/dan/toi/assets}
%
%  Cùng một bộ màu, cùng một bố cục với bản PowerPoint (pptx/ISLab_mau.pptx):
%  mọi kích thước ở đây tính bằng cm trên trang 16 x 9 cm, bản PowerPoint
%  nhân với 13,333/16 inch.
% =====================================================================
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{beamerthemeISLab}[2026/11/14 Khung slide ISLab]

\RequirePackage[T5]{fontenc}
\RequirePackage[utf8]{inputenc}
\RequirePackage{helvet}
\renewcommand{\familydefault}{\sfdefault}
\RequirePackage{graphicx}
\RequirePackage{tikz}
\usetikzlibrary{calc}

\providecommand{\ISLabAssets}{../assets}

% ---- bảng màu: lấy thẳng từ logo ------------------------------------
\definecolor{islabdam}{HTML}{244E7C}   % nền thanh tiêu đề (bản đậm của màu logo)
\definecolor{islabis}{HTML}{30649E}    % đúng màu chữ "IS" của logo
\definecolor{islablab}{HTML}{6B95C5}   % đúng màu chữ "Lab" của logo
\definecolor{islabcam}{HTML}{C86A2C}   % màu nhấn: số liệu, điểm cần chú ý
\definecolor{islabnhat}{HTML}{EFF3F9}  % nền khối nhạt
\definecolor{islabvien}{HTML}{C6D6E9}  % viền khối, đường kẻ
\definecolor{islabmo}{HTML}{5A6472}    % chữ phụ, chú thích
\definecolor{islabphu}{HTML}{BFD6F2}   % chữ phụ trên nền đậm
\definecolor{islabchu}{HTML}{1A1A1A}   % chữ chính

\setbeamercolor{normal text}{fg=islabchu,bg=white}
\setbeamercolor{structure}{fg=islabis}
\setbeamercolor{alerted text}{fg=islabcam}
\setbeamercolor{frametitle}{fg=white}
\setbeamercolor{block title}{fg=white,bg=islabdam}
\setbeamercolor{block body}{fg=islabchu,bg=islabnhat}
\setbeamercolor{block title alerted}{fg=white,bg=islabcam}
\setbeamercolor{block body alerted}{fg=islabchu,bg=islabnhat}
\setbeamercolor{block title example}{fg=white,bg=islabis}
\setbeamercolor{block body example}{fg=islabchu,bg=islabnhat}
\setbeamercolor{itemize item}{fg=islablab}
\setbeamercolor{itemize subitem}{fg=islablab}
\setbeamercolor{enumerate item}{fg=islabis}
\setbeamercolor{caption name}{fg=islabis}
\setbeamercolor{caption}{fg=islabmo}

\setbeamerfont{frametitle}{size=\fontsize{12.5}{15}\selectfont,series=\bfseries}
\setbeamerfont{block title}{size=\small,series=\bfseries}
\setbeamerfont{caption}{size=\scriptsize}
\setbeamerfont{alerted text}{series=\bfseries}

\setbeamertemplate{navigation symbols}{}
\setbeamertemplate{itemize item}{\raisebox{0.18ex}{\scalebox{0.75}{$\blacksquare$}}}
\setbeamertemplate{itemize subitem}{\raisebox{0.2ex}{\scalebox{0.6}{$\blacksquare$}}}
\setbeamertemplate{enumerate items}[default]
\setbeamertemplate{caption}{\centering\insertcaption\par}
\setbeamersize{text margin left=0.66cm,text margin right=0.66cm}
\setlength{\leftmargini}{1.2em}

% ---- tên ngắn in ở chân trang ---------------------------------------
