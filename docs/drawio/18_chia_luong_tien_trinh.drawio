<mxfile host="app.diagrams.net" agent="pfdet-drone-follow" type="device">
  <diagram id="Chia_luồng_và_tiến_trình_khi_bay" name="Chia luồng và tiến trình khi bay">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1"
