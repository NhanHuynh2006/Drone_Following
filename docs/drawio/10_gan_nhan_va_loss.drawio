        math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t1" value="Gán nhãn &amp; hàm mất mát — vì sao SteadyDet-N nhìn được người tí xíu" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=22;fontFamily=Helvetica;fontColor=#102A43;fontStyle=1" vertex="1" parent="1"><mxGeometry x="60" y="25" width="1250" height="34" as="geometry"/></mxCell>
        <mxCell id="t2" value="utils/losses_v15.py (SteadyDet-N dùng chung contract head nên dùng chung loss) · TAL + STAL + QFL + NWD/CIoU + ASL + ProgLoss" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=13;fontFamily=Helvetica;fontColor=#627D98;fontStyle=0" vertex="1" parent="1"><mxGeometry x="60" y="55" width="1250" height="40" as="geometry"/></mxCell>
        <mxCell id="n3" value="Dự đoán 4 mức
(B,5,H,W) × 4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#6A1B9A;fontColor=#4A148C;strokeWidth=1.5;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;arcSize=12;dashed=0;opacity=100;" vertex="1" parent="1"><mxGeometry x="70" y="130" width="200" height="60" as="geometry"/></mxCell>
        <mxCell id="n4" value="Nhãn thật
hộp người (xywh)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;fontColor=#0D47A1;strokeWidth=1.5;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;arcSize=12;dashed=0;opacity=100;" vertex="1" parent="1"><mxGeometry x="70" y="230" width="200" height="60" as="geometry"/></mxCell>
        <mxCell id="g5" value="BƯỚC 1 — chọn ô nào chịu trách nhiệm cho mỗi người (TAL + STAL)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFEF5;strokeColor=#F9A825;fontColor=#F57F17;dashed=1;dashPattern=8 6;strokeWidth=1.5;fontSize=13;fontFamily=Helvetica;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;arcSize=6;fontStyle=1" vertex="1" parent="1"><mxGeometry x="320" y="105" width="620" height="320" as="geometry"/></mxCell>
        <mxCell id="n6" value="Chọn mức theo cỡ hộp
scale_ranges (0-48 / 24-112 / 80-200 / 160+)
có CHỒNG LẤN → một người có thể ở 2 mức" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFDE7;strokeColor=#F9A825;fontColor=#F57F17;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;align=center;verticalAlign=middle;arcSize=12;dashed=0;opacity=100;" vertex="1" parent="1"><mxGeometry x="345" y="145" width="265" height="60" as="geometry"/></mxCell>
        <mxCell id="n7" value="Ô ứng viên quanh tâm hộp
bán kính 3 ô nếu hộp tí xíu, 2 ô nếu thường" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFDE7;strokeColor=#F9A825;fontColor=#F57F17;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;align=center;verticalAlign=middle;arcSize=12;dashed=0;opacity=100;" vertex="1" parent="1"><mxGeometry x="345" y="225" width="265" height="60" as="geometry"/></mxCell>
        <mxCell id="n8" value="Điểm khớp = cls^1.0 · IoU^8.0 · thưởng STAL
thưởng = 1 + 2·exp(−diện tích / 576)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFDE7;strokeColor=#F9A825;fontColor=#F57F17;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;align=center;verticalAlign=middle;arcSize=12;dashed=0;opacity=100;" vertex="1" parent="1"><mxGeometry x="640" y="145" width="275" height="60" as="geometry"/></mxCell>
        <mxCell id="n9" value="Lấy top-k:  k = 6 nếu hộp &lt; 576 px²,  k = 3 nếu thường
k giảm dần về 3/2 theo epoch (ProgLoss)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFDE7;strokeColor=#F9A825;fontColor=#F57F17;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;align=center;verticalAlign=middle;arcSize=12;dashed=0;opacity=100;" vertex="1" parent="1"><mxGeometry x="640" y="225" width="275" height="60" as="geometry"/></mxCell>
        <mxCell id="n10" value="BẢO HIỂM cho hộp SIÊU nhỏ (&lt; 64 px²): nếu chưa đủ 4 ô thì NỚI bán kính thêm 1 rồi chọn lại
→ không người nào bị bỏ trắng, đây là thứ giữ được recall ở VisDrone" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFDE7;strokeColor=#F9A825;fontColor=#F57F17;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;align=center;verticalAlign=middle;arcSize=12;dashed=0;opacity=100;" vertex="1" parent="1"><mxGeometry x="345" y="315" width="570" height="60" as="geometry"/></mxCell>
