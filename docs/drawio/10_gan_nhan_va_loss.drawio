  <diagram id="Gán_nhãn_và_hàm_mất_mát_của_SteadyDet-N" name="Gán nhãn và hàm mất mát của SteadyDet-N">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1"
