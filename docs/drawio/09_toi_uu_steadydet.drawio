        <mxCell id="t1" value="Bốn quyết định làm nên SteadyDet-N — từ 12.9 xuống 4.6 GFLOPs mà vẫn giữ nhánh P2" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=22;fontFamily=Helvetica;fontColor=#102A43;fontStyle=1" vertex="1" parent="1"><mxGeometry x="60" y="25" width="1250" height="34" as="geometry"/></mxCell>
        <mxCell id="t2" value="Mỗi ô: VẤN ĐỀ đo được → CÁCH SỬA trong models/pfdet_nano_v17.py → GIÁ PHẢI TRẢ" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=13;fontFamily=Helvetica;fontColor=#627D98;fontStyle=0" vertex="1" parent="1"><mxGeometry x="60" y="55" width="1250" height="40" as="geometry"/></mxCell>
        <mxCell id="g3" value="1 · Head quá đắt ở độ phân giải cao" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCFCFD;strokeColor=#BDBDBD;fontColor=#616161;dashed=0;dashPattern=8 6;strokeWidth=1.5;fontSize=13;fontFamily=Helvetica;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;arcSize=6;fontStyle=1" vertex="1" parent="1"><mxGeometry x="60" y="120" width="1380" height="160" as="geometry"/></mxCell>
        <mxCell id="n4" value="Head decoupled 5 conv 3×3 đầy đủ chạy tại 160×160:
