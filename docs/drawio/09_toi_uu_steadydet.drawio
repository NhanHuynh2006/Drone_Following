        <mxCell id="g24" value="4 · Phải gộp được BN, phải INT8 được" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCFCFD;strokeColor=#BDBDBD;fontColor=#616161;dashed=0;dashPattern=8 6;strokeWidth=1.5;fontSize=13;fontFamily=Helvetica;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;arcSize=6;fontStyle=1" vertex="1" parent="1"><mxGeometry x="60" y="660" width="1380" height="160" as="geometry"/></mxCell>
        <mxCell id="n25" value="Hailo-8L chạy INT8. Conv+BN rời và nhánh rẽ lạ
