        <mxCell id="g17" value="3 · Attention đặt sai chỗ thì phá ngân sách" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCFCFD;strokeColor=#BDBDBD;fontColor=#616161;dashed=0;dashPattern=8 6;strokeWidth=1.5;fontSize=13;fontFamily=Helvetica;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;arcSize=6;fontStyle=1" vertex="1" parent="1"><mxGeometry x="60" y="480" width="1380" height="160" as="geometry"/></mxCell>
        <mxCell id="n18" value="Chi phí attention tỉ lệ số ô. Đặt ở P3 (80×80)
