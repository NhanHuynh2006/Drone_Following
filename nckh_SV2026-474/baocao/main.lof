\contentsline {figure}{\numberline {2.1}{\ignorespaces Ba nguồn dữ liệu của đề tài và nhãn bounding box tương ứng: VisDrone-person chụp từ trên cao (trái), COCO-person ở cự ly gần (giữa) và khung hình bay thật ở độ cao khoảng 6\,m (phải)}}{13}{figure.caption.11}%
\contentsline {figure}{\numberline {2.2}{\ignorespaces Minh hoạ ba mức rung VisDrone-Shake trên một ảnh VisDrone (hàng trên) và một khung bay thật (hàng dưới); hướng nhoè cố định $35^\circ $ để dễ so sánh}}{16}{figure.caption.14}%
\addvspace {10\p@ }
\contentsline {figure}{\numberline {3.1}{\ignorespaces Kiến trúc SteadyDet-N; độ phân giải giảm dần từ trên xuống. Chi phí được phân bổ không đối xứng: nhánh $P_2$ (nét đứt) chỉ có một khối, số kênh bằng một nửa và head tách được, còn các khối CSP hai tầng và phép self-attention nằm ở những mức có bản đồ nhỏ}}{22}{figure.caption.15}%
\contentsline {figure}{\numberline {3.2}{\ignorespaces (a) Huấn luyện nhận biết rung: một nửa số lô được thay bằng bản đã làm rung và tính hàm mất mát phát hiện thông thường. (b) Biến thể ràng buộc nhất quán: truyền xuôi cả hai bản và kéo dự đoán trên ảnh rung về phía dự đoán trên ảnh sạch đã dừng gradient. Cả hai chỉ tồn tại khi huấn luyện}}{27}{figure.caption.17}%
\addvspace {10\p@ }
\contentsline {figure}{\numberline {4.1}{\ignorespaces AP@[.50:.95] theo mức rung. Mô hình gốc (nét đứt) có AP sạch cao hơn nhưng giảm nhanh nhất; sau huấn luyện nhận biết rung (nét liền xanh), SteadyDet-N vượt YOLO11-n và RT-DETR-l từ mức rung 2. Thanh sai số: độ lệch chuẩn qua 3 hạt giống}}{31}{figure.caption.19}%
\contentsline {figure}{\numberline {4.2}{\ignorespaces Tỷ lệ giữ độ chính xác khi rung của mọi mô hình. Bốn thế hệ YOLO bản nano nằm sát nhau ở 19--20\% dù khác nhau về kiến trúc; hai mô hình của đề tài sau huấn luyện nhận biết rung đứng đầu}}{34}{figure.caption.21}%
\addvspace {10\p@ }
\contentsline {figure}{\numberline {5.1}{\ignorespaces Quy trình đưa mô hình lên NPU: biên dịch một lần trên máy tính x86 (trên) và chuỗi xử lý mỗi khung hình trên Raspberry Pi~5 (dưới)}}{38}{figure.caption.23}%
\contentsline {figure}{\numberline {5.2}{\ignorespaces F1 của mô hình triển khai theo ngưỡng tin cậy trên 92 khung bay thật}}{42}{figure.caption.26}%
\contentsline {figure}{\numberline {5.3}{\ignorespaces Phân bổ độ trễ trung vị theo chặng so với ngân sách 33,3\,ms của vòng lặp 30\,Hz}}{45}{figure.caption.30}%
\addvspace {10\p@ }
\contentsline {figure}{\numberline {6.1}{\ignorespaces Kiến trúc tổng thể hệ thống. Toàn bộ khối xử lý nằm trên Raspberry Pi~5; bảng giám sát chỉ đọc (trừ nút đổi mục tiêu); tay điều khiển RC luôn có quyền ưu tiên cao nhất}}{46}{figure.caption.31}%
\contentsline {figure}{\numberline {6.2}{\ignorespaces Lưu đồ một vòng lặp điều khiển 30\,Hz trong \texttt {main.py}}}{47}{figure.caption.32}%
\contentsline {figure}{\numberline {6.3}{\ignorespaces Máy trạng thái của thang mất mục tiêu; phần mềm không bao giờ tự đổi chế độ bay}}{51}{figure.caption.35}%
\addvspace {10\p@ }
\contentsline {figure}{\numberline {7.1}{\ignorespaces Ba khung hình trích từ video bay thử (hộp xanh: phát hiện của SteadyDet-N; dấu thập: tâm khung hình). Giây 15 và 45: phát hiện đúng. Giây 80: người bị cắt ở mép trái bị bỏ sót và có một hộp sai nhỏ}}{57}{figure.caption.39}%
\contentsline {figure}{\numberline {7.2}{\ignorespaces Vòng bám người trên video bay thử: hộp xanh lá là mục tiêu đang khoá kèm mã định danh, mũi tên nối tâm khung hình với mục tiêu, vệt vàng là quỹ đạo; bảng góc trái hiển thị trạng thái, sai số hướng và lệnh quay hướng tính được}}{57}{figure.caption.40}%
